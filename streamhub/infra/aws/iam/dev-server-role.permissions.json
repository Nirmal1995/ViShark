{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDevRevisions",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::streamhub-dev-deploy-<ACCOUNT_ID>/streamhub-dev/*"
    },
    {
      "Sid": "ReadCodeDeployAgentUpdates",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::aws-codedeploy-eu-west-1/*"
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullApiImageOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": "arn:aws:ecr:eu-west-1:<ACCOUNT_ID>:repository/streamhub-api"
    },
    {
      "Sid": "ReadDevConfigOnly",
      "Effect": "Allow",
      "Action": "ssm:GetParametersByPath",
      "Resource": [
        "arn:aws:ssm:eu-west-1:<ACCOUNT_ID>:parameter/streamhub/dev",
        "arn:aws:ssm:eu-west-1:<ACCOUNT_ID>:parameter/streamhub/dev/*"
      ]
    },
    {
      "Sid": "UploadsBucketLookups",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::streamhub-dev-uploads-<ACCOUNT_ID>"
    },
    {
      "Sid": "UploadsUnderVideosPrefixOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::streamhub-dev-uploads-<ACCOUNT_ID>/videos/*"
    }
  ]
}

{
  "name": "@streamhub/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start:local": "tsx --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1178.0",
    "@streamhub/contracts": "workspace:*",
    "bullmq": "6.7.10",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  }
}

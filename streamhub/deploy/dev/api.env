# Non-secret settings for the dev environment. Versioned in git so a change is
# reviewed and deployed like code. Secrets are NOT here: they come from SSM
# Parameter Store (/streamhub/dev/*) at deploy time.
NODE_ENV=production
LOG_LEVEL=info
LOG_PRETTY=false
API_HOST=0.0.0.0
API_PORT=4000
API_METRICS_HOST=0.0.0.0
API_METRICS_PORT=4001

# No web app or domain yet: the API is reached through SSM port forwarding on
# http://localhost:4000. Swagger UI is enabled for that; the Origin of
# requests from it must be trusted. Browsers allow Secure cookies on
# http://localhost, so COOKIE_SECURE stays on.
API_DOCS_ENABLED=true
WEB_ORIGIN=https://streamhub-dev.invalid
CSRF_EXTRA_TRUSTED_ORIGINS=http://localhost:4000

MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Object storage: S3 through the instance role (no endpoint, no keys, ADR-044).
# The bucket name comes from SSM (S3_BUCKET_UPLOADS). The containers reach the
# instance role because the metadata hop limit is 2 on the dev server (ADR-045).
S3_REGION=eu-west-1
S3_FORCE_PATH_STYLE=false

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=StreamHub Dev <no-reply@streamhub-dev.invalid>
